# ===== Evo memory/evolution workflows =====
# Import workflow/EVO02_语义记忆抽取工作流.yml, then set this app API key.
DIFY_EVO_SEMANTIC_API_BASE=https://api.dify.ai
DIFY_EVO_SEMANTIC_API_KEY=REPLACE_WITH_DIFY_EVO_SEMANTIC_API_KEY
DIFY_EVO_SEMANTIC_TIMEOUT=20
# Import workflow/EVO03_反思经验生成工作流.yml, then set this app API key.
DIFY_EVO_REFLECTIVE_ENABLED=true
DIFY_EVO_REFLECTIVE_HOUR=2
DIFY_EVO_REFLECTIVE_API_BASE=https://api.dify.ai
DIFY_EVO_REFLECTIVE_API_KEY=REPLACE_WITH_DIFY_EVO_REFLECTIVE_API_KEY
DIFY_EVO_REFLECTIVE_TIMEOUT=30
# Import workflow/EVO04_技能规则综合工作流.yml, then set this app API key.
DIFY_EVO_PROCEDURAL_ENABLED=true
DIFY_EVO_PROCEDURAL_WEEKDAY=6
DIFY_EVO_PROCEDURAL_HOUR=3
DIFY_EVO_PROCEDURAL_API_BASE=https://api.dify.ai
DIFY_EVO_PROCEDURAL_API_KEY=REPLACE_WITH_DIFY_EVO_PROCEDURAL_API_KEY
DIFY_EVO_PROCEDURAL_TIMEOUT=30
DIFY_EVO_PROMOTION_ENABLED=true
DIFY_EVO_PROMOTION_HOUR=4
DIFY_EVO_SAFETY_ENABLED=true
DIFY_EVO_SAFETY_HOUR=5

JWT_SECRET_KEY=REPLACE_WITH_STRONG_JWT_SECRET_32
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=*
DEMO_SEED_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_BEFORE_USE
DISABLE_DEMO_USER_SEED=true

# ===== 知识库管理 =====
DIFY_KNOWLEDGE_API_KEY=REPLACE_WITH_DIFY_KNOWLEDGE_API_KEY
